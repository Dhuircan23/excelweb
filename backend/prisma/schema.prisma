// Prisma schema for the ExcelWeb commercial MVP.
// Postgres everywhere — dev and prod — to avoid drift between the two.
// See README.md for how to get a local Postgres running.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}

// A commercial diagnostic request submitted from /diagnostico.
model Lead {
  id        String   @id @default(cuid())
  status    LeadStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Step 1 — contact info
  name     String
  company  String
  email    String
  whatsapp String?
  industry String?

  // Step 2 — current process
  currentProcess String // "¿Qué haces actualmente con Excel?"
  fileCount      String? // segmented option label, e.g. "2–5"
  peopleCount    String? // segmented option label, e.g. "6–20"
  manualParts    String?
  problems       String?
  automationGoal String?

  // Step 3 — goal
  improvementCategories String // JSON-encoded string[] — a fixed short enum, not worth a join table

  files LeadFile[]

  @@index([createdAt])
  @@index([email])
}

// A file attached to a diagnostic request (Excel export, PDF, screenshot...).
model LeadFile {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([leadId])
}

// Lightweight product-analytics events (CTA clicks, demo funnel, form funnel).
// Intentionally minimal: no PII, no session replay — just named events with
// a small JSON payload, enough to see where the funnel leaks.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  payload   String? // JSON-encoded, optional
  path      String?
  createdAt DateTime @default(now())

  @@index([name])
  @@index([createdAt])
}
