# Copy to .env and fill in for local development.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000

# SQLite by default (zero setup). For production, use a managed Postgres
# instance and set: DATABASE_URL=postgresql://user:pass@host:5432/db
# (also change `provider = "postgresql"` in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Where uploaded diagnostic attachments are stored on disk.
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_LEAD=5

# Optional: SMTP credentials to email the commercial team when a new lead
# arrives. If unset, leads are still saved — the notification is just skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ExcelWeb <hola@excelweb.app>"
LEADS_NOTIFICATION_EMAIL=
